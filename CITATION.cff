    orcid: "https://orcid.org/0000-0002-8585-1087"
    affiliation: "Department of Electrical and Computer Engineering, Baylor University"
    email: Liang_Dong@baylor.edu
keywords:
  - quantum error correction
  - surface code
  - minimum-weight perfect matching
  - decoder calibration
  - detector error model
